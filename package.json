{
  "name": "web-world-themes",
  "version": "0.1.0",
  "private": true,
  "description": "A theme-first Chrome extension for dressing existing websites in another world.",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:playground": "node scripts/build-playground.mjs",
    "build:deploy-probe": "node scripts/build-deploy-probe.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.world.json && tsc --noEmit -p tsconfig.editor-core.json",
    "test:setup": "node scripts/test.mjs --install",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs --project=unit",
    "test:e2e": "node scripts/test.mjs --project=e2e --project=g1-other-way --workers=1",
    "check": "npm run lint && npm run build && npm test",
    "lint": "npm run format:check && node scripts/lint.mjs && eslint src tests playwright.config.ts --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "benchmark:world": "node scripts/benchmark-world.mjs",
    "benchmark:timeline": "node scripts/benchmark-signal-timeline.mjs",
    "benchmark:motion": "node scripts/benchmark-signal-motion.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.4",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "three": "0.186.1"
  }
}
