{
  "name": "web-world-themes",
  "version": "0.1.0",
  "private": true,
  "description": "A theme-first Chrome extension for dressing existing websites in another world.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.world.json && tsc --noEmit -p tsconfig.editor-core.json",
    "test:setup": "node scripts/test.mjs --install",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs --project=unit",
    "test:e2e": "node scripts/test.mjs --project=e2e",
    "check": "npm run lint && npm run build && npm test",
    "lint": "node scripts/lint.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "benchmark:world": "node scripts/benchmark-world.mjs",
    "benchmark:timeline": "node scripts/benchmark-signal-timeline.mjs",
    "benchmark:motion": "node scripts/benchmark-signal-motion.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.4",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.186.1"
  }
}
