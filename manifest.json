{
  "manifest_version": 3,
  "name": "Web World Themes",
  "version": "0.1.0",
  "description": "YouTubeの上に、自分で作った世界（UIの着せ替え・画像・3Dモデル）を表示する拡張機能です。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "sidePanel"],
  "background": {
    "service_worker": "background/index.js"
  },
  "action": {
    "default_title": "Web World Themes",
    "default_popup": "popup/index.html"
  },
  "commands": {
    "emergency-off": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "作品の描画を緊急停止（再開は設定から）"
    },
    "open-editor": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "エディターを直接開く"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "exclude_matches": ["https://www.youtube.com/embed/*", "https://www.youtube.com/live_chat*"],
      "js": ["content/index.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/read-frame.html"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
